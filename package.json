{
  "name": "ai-organiser",
  "version": "1.0.21",
  "description": "AI-powered note organization with 50+ commands: tagging, summarization, web research, meeting minutes, presentations, semantic search, Kindle sync, and more. Supports 14 cloud providers and local LLMs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run test:all && node esbuild.config.mjs production",
    "build:quick": "npx tsc -p tsconfig.build.json -noEmit && node esbuild.config.mjs production",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:auto": "node scripts/automated-tests.js",
    "test:e2e": "playwright test",
    "test:all": "npx tsc -p tsconfig.build.json -noEmit && vitest run && node scripts/automated-tests.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "precommit": "npm run lint && npm run test:all",
    "persona:smoke": "node scripts/persona-harness/smoke.mjs",
    "persona:deploy": "node scripts/persona-harness/deploy.mjs",
    "persona:inspect": "node scripts/persona-harness/inspect-commands.mjs",
    "persona:entry-points": "node scripts/persona-harness/inspect-entry-points.mjs",
    "persona:register": "node scripts/persona-harness/register-personas.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "install-ffmpeg": "node scripts/install-ffmpeg.js",
    "arch:refresh": "node scripts/.claude-skills/symbol-index/refresh.mjs",
    "arch:refresh:full": "node scripts/.claude-skills/symbol-index/refresh.mjs --full",
    "arch:render": "node scripts/.claude-skills/symbol-index/render-mermaid.mjs",
    "arch:drift": "node scripts/.claude-skills/symbol-index/drift.mjs",
    "arch:duplicates": "node scripts/.claude-skills/symbol-index/duplicates.mjs",
    "arch:prune": "node scripts/.claude-skills/symbol-index/prune.mjs",
    "arch:spike": "node scripts/.claude-skills/symbol-index/spike-extract.mjs",
    "test:azure": "node scripts/persona-harness/azure-feature-sweep.mjs",
    "test:azure:layout": "node scripts/persona-harness/persona-layout-ab.mjs",
    "skills:hydrate": "node -e \"const{execFileSync}=require('node:child_process'),p=require('node:path'),f=require('node:fs');const main=p.dirname(execFileSync('git',['rev-parse','--path-format=absolute','--git-common-dir'],{encoding:'utf8'}).trim());const dir='scripts/.claude-skills';const src=p.join(main,dir);if(p.resolve(dir)===p.resolve(src)){console.log('[hydrate] main checkout - nothing to do');process.exit(0)}if(!f.existsSync(src)){console.error('[hydrate] no tooling at '+src+' - re-sync the main checkout first');process.exit(1)}f.cpSync(src,dir,{recursive:true});console.log('[hydrate] copied '+src)\"",
    "context:check": "node scripts/.claude-skills/check-context-drift.mjs --strict",
    "context:check:json": "node scripts/.claude-skills/check-context-drift.mjs --format json",
    "memory:health": "node scripts/.claude-skills/memory-health.mjs",
    "memory:health:json": "node scripts/.claude-skills/memory-health.mjs --json",
    "maintenance:run": "node scripts/.claude-skills/maintenance-checks.mjs",
    "maintenance:status": "node scripts/.claude-skills/maintenance-checks.mjs --status",
    "learning:weekly-review": "node scripts/.claude-skills/cross-skill.mjs learning-weekly-review",
    "learning:stats": "node scripts/.claude-skills/cross-skill.mjs learning-stats"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "tags",
    "internationalization"
  ],
  "author": "L Strydom",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@babel/traverse": "^8.0.4",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@eslint/json": "^1.2.0",
    "@google/genai": "^1.50.1",
    "@playwright/test": "^1.59.1",
    "@supabase/supabase-js": "^2.103.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.18",
    "builtin-modules": "^5.0.0",
    "codeowners-utils": "^1.0.2",
    "dependency-cruiser": "^17.3.10",
    "esbuild": "^0.27.0",
    "eslint": "^10.2.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "micromatch": "^4.0.8",
    "obsidian": "latest",
    "pdfjs-dist": "5.6.205",
    "pg": "^8.22.0",
    "proper-lockfile": "^4.1.2",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@mozilla/readability": "^0.6.0",
    "d3-array": "^3.2.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "docx": "^9.5.1",
    "dom-to-pptx": "^1.1.5",
    "dompurify": "^3.3.2",
    "dotenv": "^17.3.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^4.0.0",
    "officeparser": "^6.0.4",
    "openai": "^6.33.0",
    "perfect-freehand": "^1.2.3",
    "pptxgenjs": "^4.0.1",
    "voy-search": "^0.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10"
  }
}
