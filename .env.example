# ai-organiser .env
# Layout follows docs/reference/env-file-convention.md (claude-engineering-skills):
# numbered sections, one comment line per key, shared keys live in ~/.audit-loop.env.
# Template: copy to .env and fill in. Keys only — never put real values here.

# ══════════════════════════════════════════════════════════════════════
# 1. LLM PROVIDERS
# ══════════════════════════════════════════════════════════════════════

# Anthropic API key (shared with ~/.audit-loop.env).
ANTHROPIC_API_KEY=

# OpenAI API key (local value wins over ~/.audit-loop.env).
OPENAI_API_KEY=

# Google Gemini API key (shared).
GEMINI_API_KEY=

# Pinned GPT auditor model id.
OPENAI_AUDIT_MODEL=

# ══════════════════════════════════════════════════════════════════════
# 2. AZURE WORK PROFILE
# ══════════════════════════════════════════════════════════════════════

# Azure APIM subscription key (valid only against AZURE_OPENAI_ENDPOINT).
AZURE_OPENAI_API_KEY=

# Azure OpenAI endpoint. Its presence activates the Azure profile.
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API version.
AZURE_OPENAI_API_VERSION=

# Azure GPT deployment name.
AZURE_OPENAI_GPT_DEPLOYMENT=

# Azure AI Foundry endpoint (Claude models).
AZURE_AI_ENDPOINT=

# ══════════════════════════════════════════════════════════════════════
# 4. AUDIT-LOOP TOOL
# ══════════════════════════════════════════════════════════════════════

# owner/repo slug matching audit_repos.name.
LEARNING_REPO_NAME=

# Repo identity for persona-test cross-references (owner/repo).
PERSONA_TEST_REPO_NAME=

# Audit-project URL for persona-test telemetry.
PERSONA_TEST_SUPABASE_URL=

# Audit-project anon key for persona-test telemetry.
PERSONA_TEST_SUPABASE_ANON_KEY=

# ══════════════════════════════════════════════════════════════════════
# 6. THIRD-PARTY SERVICES
# ══════════════════════════════════════════════════════════════════════

# Deepgram key (v2 diarization spike; to be rotated or removed after the pick).
DEEPGRAM_API_KEY=

# Speechmatics key (v2 diarization spike).
SPEECHMATICS_API_KEY=

# ══════════════════════════════════════════════════════════════════════
# 7. FEATURE FLAGS / KILL SWITCHES
# ══════════════════════════════════════════════════════════════════════

# 1 = run the weekly maintenance checks locally from the pre-push hook.
AUDIT_LOOP_WEEKLY_MAINTENANCE=

# ══════════════════════════════════════════════════════════════════════
# 8. LOCAL DEV ONLY
# ══════════════════════════════════════════════════════════════════════

# Amazon login for dev testing of the Kindle auth flow only.
AMAZON_EMAIL=

# Amazon password for dev testing only (never persisted in plugin storage).
AMAZON_PASSWORD=

# ══════════════════════════════════════════════════════════════════════
# 9. UNUSED? (Louis to confirm)
# ══════════════════════════════════════════════════════════════════════
# Moved, not deleted. Nothing in code reads these, or the name looks wrong. Louis decides.

# Native Foundry key - nothing reads this name; code expects AZURE_AI_API_KEY.
AZURE_AI_FOUNDRY_API_KEY=

# Unknown name - nothing reads it.
ELISA=

# Bright Data Web Unlocker key - nothing reads this spelling.
BRIGHT_DATA_API_KEY=

# Bright Data Scraping Browser WSS endpoint - nothing reads it.
BRIGHT_DATA_BROWSER_WSS=

# Supabase management token - nothing reads it.
SUPABASE_ACCESS_TOKEN=

# Legacy audit-store URL - sunset (store is AUDIT_DB_URL).
SUPABASE_AUDIT_URL=

# Legacy audit-store anon key - sunset.
SUPABASE_AUDIT_ANON_KEY=

# Legacy audit-store service-role key - sunset.
SUPABASE_AUDIT_SERVICE_ROLE_KEY=
