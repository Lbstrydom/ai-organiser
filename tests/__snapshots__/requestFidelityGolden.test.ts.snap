exports[`request fidelity golden > azure deployment-based (OpenAI main) 1`] = `
{
  "azureUrls": {
    "chat": "https://my-resource.openai.azure.com/openai/deployments/gpt-chat-dep/chat/completions?api-version=2025-03-01-preview",
    "claude": "https://my-resource.services.ai.azure.com/anthropic/v1/messages",
    "embeddings": "https://my-resource.openai.azure.com/openai/deployments/embed-dep/embeddings?api-version=2025-03-01-preview",
    "imageEmbeddings": "https://my-resource.services.ai.azure.com/models/images/embeddings?api-version=2024-05-01-preview",
    "speech": "https://my-resource.openai.azure.com/openai/deployments/tts/audio/speech?api-version=2024-10-21",
    "whisper": "https://my-resource.openai.azure.com/openai/deployments/whisper/audio/transcriptions?api-version=2024-10-21",
  },
  "chat": {
    "body": {
      "max_tokens": 8192,
      "messages": [
        {
          "content": "Complete the task in the user message and follow its output format exactly.",
          "role": "system",
        },
        {
          "content": "hello",
          "role": "user",
        },
      ],
      "model": "gpt-chat-dep",
      "temperature": 0.3,
    },
    "headers": [
      "Content-Type: application/json",
      "api-key: AZ-KEY",
    ],
    "url": "https://my-resource.openai.azure.com/openai/deployments/gpt-chat-dep/chat/completions?api-version=2025-03-01-preview",
  },
}
`;

exports[`request fidelity golden > azure gateway 1`] = `
{
  "azureUrls": {
    "chat": "https://my-apim.azure-api.net/foundry/openai/deployments/gpt-5.5/chat/completions?api-version=2025-03-01-preview",
    "claude": "https://my-apim.azure-api.net/foundry/anthropic/v1/messages",
