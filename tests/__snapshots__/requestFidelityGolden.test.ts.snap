    "imageEmbeddings": "https://my-resource.services.ai.azure.com/models/images/embeddings?api-version=2024-05-01-preview",
    "speech": "https://my-apim.azure-api.net/foundry/openai/deployments/tts/audio/speech?api-version=2024-10-21",
    "whisper": "https://my-apim.azure-api.net/foundry/openai/deployments/whisper/audio/transcriptions?api-version=2024-10-21",
  },
  "chat": {
    "body": {
      "max_tokens": 8192,
      "messages": [
        {
          "content": "hello",
          "role": "user",
        },
      ],
      "model": "claude-sonnet-5-5",
      "output_config": {
        "effort": "low",
      },
      "system": "Complete the task in the user message and follow its output format exactly.",
    },
    "headers": [
